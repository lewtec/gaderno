package pages

import "github.com/lucasew/gaderno/internal/ui/layout"

type WorkspaceData struct {
	Notebooks []string
}

templ Workspace(d WorkspaceData) {
	@layout.Document("gaderno") {
		<body class="min-h-full bg-base-100 text-base-content text-sm">
			<header class="g-topbar sticky top-0 z-50 bg-base-100/90 backdrop-blur-sm border-b border-base-300">
				<div class="g-topbar-inner">
					<a href="/" class="g-logo" title="gaderno" aria-label="gaderno home"><img src="/static/logo.png" width="32" height="32" alt=""/></a>
					<span class="g-topbar-title">Workspace</span>
					<span class="flex-1"></span>
					<details class="dropdown dropdown-end">
						<summary class="g-icon-btn" aria-label="Menu" title="Menu">
							<span class="g-avatar" id="ws-avatar" aria-hidden="true">·</span>
						</summary>
						<ul class="menu dropdown-content bg-base-100 rounded-box z-50 w-52 p-2 shadow-md border border-base-300 text-sm mt-1">
							<li class="menu-title text-xs">Theme</li>
							<li><button type="button" class="theme-set" data-gaderno-theme="gaderno-light">Light</button></li>
							<li><button type="button" class="theme-set" data-gaderno-theme="gaderno-dark">Dark</button></li>
							<li class="menu-title text-xs">About</li>
							<li><span class="text-xs text-base-content/60 pointer-events-none">Local notebooks · server owns state</span></li>
						</ul>
					</details>
				</div>
			</header>
			<main class="g-workspace">
				<header class="mb-6">
					<h1 class="text-2xl font-semibold tracking-tight text-balance">Notebooks</h1>
					<p class="text-sm text-base-content/60 mt-1 max-w-prose">
						Open a notebook or create one. Kernels run on this host; the server holds the live document.
					</p>
				</header>
				if len(d.Notebooks) > 0 {
					<ul class="g-nb-list" role="list">
						for _, name := range d.Notebooks {
							<li>
								<a class="g-nb-row" href={ notebookOpenURL(name) }>
									<span class="g-nb-icon" aria-hidden="true">
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
											<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
											<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
											<path d="M8 7h8M8 11h6"></path>
										</svg>
									</span>
									<span class="g-nb-name font-code">{ name }</span>
									<span class="g-nb-chevron text-base-content/35" aria-hidden="true">→</span>
								</a>
							</li>
						}
					</ul>
				} else {
					<div class="g-empty">
						<p class="font-medium">No notebooks yet</p>
						<p class="text-sm text-base-content/55 mt-1">Create one below — a blank code cell is waiting.</p>
					</div>
				}
				<form class="g-create mt-6" method="post" action="/api/notebooks">
					<label class="sr-only" for="nb-name">Notebook file name</label>
					<input
						id="nb-name"
						type="text"
						name="name"
						placeholder="name.ipynb"
						required
						autocomplete="off"
						class="input input-bordered font-code flex-1 min-w-0"
					/>
					<button class="btn btn-primary gap-1.5 shrink-0" type="submit">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
						Create
					</button>
				</form>
			</main>
			<script>
				(function () {
					try {
						var n = localStorage.getItem("gaderno-display-name") || "";
						var el = document.getElementById("ws-avatar");
						if (el) el.textContent = (n.trim()[0] || "?").toUpperCase();
					} catch (e) {}
				})();
			</script>
		</body>
	}
}
